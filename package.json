{
  "name": "biosim",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3016",
    "build": "vite build",
    "build:vercel": "vite build",
    "check": "tsc --noEmit",
    "test:physiology": "tsx --test tests/physiology.test.ts tests/timeline.test.ts",
    "test:browser": "playwright test",
    "test:browser:production": "playwright test --config playwright.production.config.ts",
    "test": "npm run test:physiology && npm run test:anatomy && npm run test:browser",
    "test:anatomy": "tsx --test tests/physical-anatomy.test.ts tests/vessel-flow.test.ts tests/body-lens.test.ts tests/heart.test.ts tests/heart-motion.test.ts tests/hormone-lens.test.ts tests/meal-route.test.ts tests/meal-mark.test.ts tests/knee-jerk.test.ts",
    "build:heart": "tsx scripts/heart/build-heart-motion.ts",
    "build:vessels": "work/p1/venv/bin/python scripts/vessels/build-calibrated-vessels.py && work/p1/venv/bin/python scripts/vessels/build-reconstructed-vessels.py && work/p1/venv/bin/python scripts/vessels/build-registered-vessels.py && work/p1/venv/bin/python scripts/vessels/build-vessel-graph.py",
    "test:vessels": "work/p1/venv/bin/python -m unittest discover -s scripts/vessels -p 'test_*.py'",
    "verify": "npm run verify:directions; npm run verify:containment -- --parts system:nervous; npm run verify:nerves; npm run verify:visual; npm run verify:report",
    "verify:directions": "tsx --test verify/directions.test.ts verify/round-trip.test.ts verify/containment.test.ts",
    "verify:visual": "playwright test --config playwright.verify.config.ts",
    "verify:containment": "tsx verify/containment.ts",
    "verify:nerves": "tsx verify/containment.ts --parts \"^ZA-(?!(left|right)-(inferior-alveolar|mental)-nerve)\" --clear-of system:skeletal --except \"fibularis|iliotibial|levator scapulae|subscapularis|tibialis\" --allow 0.002",
    "verify:report": "tsx verify/report.ts"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.159.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.159.0",
    "@vitejs/plugin-react": "6.0.2",
    "meshoptimizer": "^1.2.0",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "type": "module",
  "license": "MIT"
}
