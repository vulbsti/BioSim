{
  "name": "anatomy-studio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3016",
    "build": "vite build",
    "build:vercel": "vite build",
    "check": "tsc --noEmit",
    "test:physiology": "tsx --test tests/physiology.test.ts tests/timeline.test.ts",
    "test:browser": "playwright test",
    "test:browser:production": "playwright test --config playwright.production.config.ts",
    "audit:brain": "tsx scripts/audit-brain-vessels.ts",
    "test": "npm run test:physiology && npm run test:anatomy && npm run test:multiscale && npm run test:blender-geometry && npm run test:tissue && npm run test:circulation && npm run test:p4 && npm run test:browser",
    "test:p4": "tsx --test tests/p4-meal.test.ts tests/p4-recording.test.ts tests/m1-coupling.test.ts tests/meal-mark.test.ts",
    "test:anatomy": "tsx --test tests/physical-anatomy.test.ts tests/vessel-flow.test.ts tests/body-lens.test.ts tests/heart.test.ts tests/heart-motion.test.ts tests/hormone-lens.test.ts tests/molecules.test.ts",
    "build:heart": "tsx scripts/heart/build-heart-motion.ts",
    "build:vessels": "work/p1/venv/bin/python scripts/vessels/build-calibrated-vessels.py && work/p1/venv/bin/python scripts/vessels/build-reconstructed-vessels.py && work/p1/venv/bin/python scripts/vessels/build-registered-vessels.py && work/p1/venv/bin/python scripts/vessels/build-vessel-graph.py",
    "test:vessels": "work/p1/venv/bin/python -m unittest discover -s scripts/vessels -p 'test_*.py'",
    "test:multiscale": "tsx --test tests/multiscale.test.ts",
    "verify:multiscale": "tsx scripts/verify-multiscale.ts",
    "test:tissue": "tsx --test tests/tissue.test.ts",
    "verify:tissue": "tsx scripts/verify-tissue.ts",
    "test:circulation": "tsx --test tests/circulation.test.ts",
    "verify:circulation": "tsx scripts/verify-circulation.ts",
    "verify:excitation": "tsx scripts/verify-excitation.ts",
    "generate:excitation": "node scripts/generate-shorten.mjs",
    "build:tissue": "node scripts/blender/build-package.mjs",
    "test:blender-geometry": "python3 -m unittest discover -s scripts/blender -p 'test_*.py'",
    "render:diagnostics": "node scripts/blender/render-diagnostics.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "@types/three": "^0.159.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.6",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "three": "^0.159.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "meshoptimizer": "^1.2.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "license": "MIT"
}
